# --- Servidor ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=500

# --- Base de datos / cola ---
DATABASE_URL=postgres://traductor:traductor@localhost:5432/traductor
REDIS_URL=redis://localhost:6379

# --- Almacenamiento S3 (AWS S3, Cloudflare R2 o MinIO en local) ---
S3_BUCKET=traductor-videos
S3_REGION=us-east-1
# Solo para R2/MinIO; déjalo vacío en AWS S3
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- IA: voz a texto (OpenAI) ---
OPENAI_API_KEY=
STT_MODEL=whisper-1

# --- IA: traducción (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = menor costo y latencia por segmento; súbelo si la calidad no alcanza
CLAUDE_EFFORT=low

# --- Procesamiento ---
SEGMENTO_SEGUNDOS=20
MAX_INTENTOS_SEGMENTO=4
# Tope de caracteres que se envían al modelo por segmento (controla costo)
MAX_CHARS_SEGMENTO=2000
MAX_CHARS_CONTEXTO=600
WORKER_CONCURRENCIA_VIDEOS=2
WORKER_CONCURRENCIA_REINTENTOS=4

# Binarios (en Docker ya están en el PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
