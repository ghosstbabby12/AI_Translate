# --- Servidor ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=500

# --- Sesiones ---
# Genera una con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-clave-aleatoria-de-32-o-mas-caracteres
JWT_EXPIRA=7d

# --- Base de datos / cola ---
DATABASE_URL=postgres://traductor:traductor@localhost:5432/traductor
REDIS_URL=redis://localhost:6379

# --- Almacenamiento S3 (AWS S3, Cloudflare R2 o SeaweedFS en local) ---
S3_BUCKET=traductor-videos
S3_REGION=us-east-1
# Solo para R2/SeaweedFS; déjalo vacío en AWS S3
S3_ENDPOINT=http://localhost:8333
S3_PUBLIC_ENDPOINT=
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# --- Modo de IA ---
# simulada = texto de prueba, sin claves ni costo (para probar el sistema)
# real     = Whisper + Claude (requiere las dos claves de abajo)
IA_MODO=simulada
IA_SIMULADA_FALLOS=0.1

# --- IA: voz a texto (OpenAI) ---
OPENAI_API_KEY=
STT_MODEL=whisper-1

# --- IA: traducción (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = menor costo y latencia por segmento; súbelo si la calidad no alcanza
CLAUDE_EFFORT=low

# --- Procesamiento ---
SEGMENTO_SEGUNDOS=20
MAX_INTENTOS_SEGMENTO=4
# Tope de caracteres que se envían al modelo por segmento (controla costo)
MAX_CHARS_SEGMENTO=2000
MAX_CHARS_CONTEXTO=600
WORKER_CONCURRENCIA_VIDEOS=2
WORKER_CONCURRENCIA_REINTENTOS=4

# Binarios (en Docker ya están en el PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_PATH=yt-dlp
